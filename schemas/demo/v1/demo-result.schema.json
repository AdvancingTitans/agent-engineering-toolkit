{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AdvancingTitans/agent-engineering-toolkit/schemas/demo/v1/demo-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "demo_id",
    "overall_status",
    "execution_status",
    "before_state",
    "after_state",
    "proof_path",
    "workspace_path",
    "diagnostics",
    "network_calls",
    "llm_calls"
  ],
  "properties": {
    "schema_version": {"const": "aet-demo-result/v1"},
    "demo_id": {"const": "stale-proof"},
    "overall_status": {
      "enum": ["PASS", "PASS_WITH_WARNING", "FAIL", "UNKNOWN", "UNAVAILABLE"]
    },
    "execution_status": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
    "before_state": {"type": "string"},
    "after_state": {"type": "string"},
    "proof_path": {"type": ["string", "null"]},
    "workspace_path": {"type": ["string", "null"]},
    "diagnostics": {"type": "array", "items": {"type": "string"}},
    "network_calls": {"type": "integer", "minimum": 0},
    "llm_calls": {"type": "integer", "minimum": 0}
  }
}
