{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advancingtitans.github.io/agent-engineering-toolkit/schemas/evidence-atlas/v1/perspective.schema.json",
  "title": "AET Evidence Atlas Perspective v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "root_diagram_ids",
    "node_ids",
    "edge_ids",
    "diagram",
    "documents"
  ],
  "properties": {
    "extensions": {"type": "object", "additionalProperties": true},
    "schema_version": {"const": "aet-evidence-perspective/1.0"},
    "id": {
      "enum": [
        "claim-chain",
        "investigation-flow",
        "change-scope",
        "verification-coverage",
        "evidence-data-flow",
        "integrations",
        "conflicts",
        "freshness",
        "improvement-chain",
        "regression-lineage",
        "behavioural-risk"
      ]
    },
    "title": {"type": "string", "minLength": 1},
    "root_diagram_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "node_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^node:"},
      "uniqueItems": true
    },
    "edge_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^edge:"},
      "uniqueItems": true
    },
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "sha256"],
      "properties": {
        "type": {
          "enum": ["flowchart", "sequenceDiagram", "timeline", "stateDiagram"]
        },
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "documents": {
      "type": "object",
      "required": [
        "actions",
        "concerns",
        "constraints",
        "context",
        "counter_evidence",
        "description",
        "evidence",
        "freshness",
        "provenance",
        "question",
        "unknowns"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"$ref": "#/$defs/relativePath"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
