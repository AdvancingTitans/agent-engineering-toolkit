{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advancingtitans.github.io/aet/schemas/planning/plan-candidate-v1.schema.json",
  "title": "AET Plan Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "summary",
    "coverage_claim",
    "edit_items",
    "investigation_items",
    "verification_steps",
    "assumptions",
    "unresolved"
  ],
  "properties": {
    "schema_version": {"const": "plan-candidate/1.0"},
    "request_id": {"type": "string", "pattern": "^REQ-[A-Z0-9._-]+$"},
    "summary": {"type": "string", "minLength": 1},
    "coverage_claim": {
      "enum": ["BOUNDED_COMPLETE", "BEST_EFFORT", "PARTIAL", "UNKNOWN"]
    },
    "edit_items": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/edit"}
    },
    "investigation_items": {"type": "array", "items": {"type": "object"}},
    "verification_steps": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/verification"}
    },
    "assumptions": {"type": "array", "items": {"type": "object"}},
    "unresolved": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "line_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_line", "end_line"],
      "properties": {
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edit_id",
        "disposition",
        "path",
        "symbol",
        "source_range",
        "intent",
        "expected_change",
        "rationale",
        "behavior_links",
        "evidence_refs",
        "atlas_refs",
        "source_refs",
        "dependencies",
        "tests",
        "risks",
        "limitations"
      ],
      "properties": {
        "edit_id": {"type": "string", "pattern": "^EDIT-[A-Z0-9._-]+$"},
        "disposition": {"enum": ["REQUIRED", "OPTIONAL", "INVESTIGATE", "DO_NOT_EDIT"]},
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "symbol": {"type": ["string", "null"]},
        "source_range": {"oneOf": [{"$ref": "#/$defs/line_range"}, {"type": "null"}]},
        "intent": {"type": "string", "minLength": 1},
        "expected_change": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "behavior_links": {"$ref": "#/$defs/strings"},
        "evidence_refs": {"$ref": "#/$defs/strings"},
        "atlas_refs": {"$ref": "#/$defs/strings"},
        "source_refs": {"$ref": "#/$defs/strings"},
        "dependencies": {"$ref": "#/$defs/strings"},
        "tests": {"$ref": "#/$defs/strings"},
        "risks": {"$ref": "#/$defs/strings"},
        "limitations": {"$ref": "#/$defs/strings"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_id",
        "description",
        "command",
        "edit_refs",
        "expected_result",
        "status"
      ],
      "properties": {
        "verification_id": {"type": "string", "pattern": "^VERIFY-[A-Z0-9._-]+$"},
        "description": {"type": "string", "minLength": 1},
        "command": {
          "oneOf": [
            {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            {"type": "null"}
          ]
        },
        "edit_refs": {"$ref": "#/$defs/strings"},
        "expected_result": {"type": "string", "minLength": 1},
        "status": {"const": "PENDING"}
      }
    }
  }
}
