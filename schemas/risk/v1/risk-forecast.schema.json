{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advancingtitans.github.io/agent-engineering-toolkit/schemas/risk/v1/risk-forecast.schema.json",
  "$comment": "Pathway-specific empirical forecast. This contract forbids a holistic risk or trust score.",
  "title": "AET Behavioural Risk Forecast v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "created_at", "diagnosis_sha256", "calibration_sha256",
    "dataset_sha256", "forecasts", "gate_status", "limitations", "provenance"
  ],
  "properties": {
    "schema_version": {"const": "aet-risk-forecast/1.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "diagnosis_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "calibration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "forecasts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pathway_id", "signature", "status", "support", "interval", "baseline", "reason"],
        "properties": {
          "pathway_id": {"type": "string", "minLength": 1},
          "signature": {"type": "string", "minLength": 1},
          "status": {"enum": ["ELEVATED", "NOT_ELEVATED", "UNKNOWN"]},
          "support": {"type": "integer", "minimum": 0},
          "interval": {"$ref": "#/$defs/interval"},
          "baseline": {"$ref": "#/$defs/interval"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "gate_status": {"enum": ["PASS", "FAIL"]},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "provenance": {"type": "object"}
  },
  "$defs": {
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "high"],
      "properties": {
        "low": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "high": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    }
  }
}
