{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advancingtitans.github.io/aet/schemas/investigated-finding-v1.schema.json",
  "$comment": "Plan sections 4.2, 4.3, 6.7, and 9: preserve authoritative evidence status while recording sourced, dialectical command-specific assessment.",
  "title": "AET Investigated Finding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "finding_type",
    "origin",
    "authoritative_status",
    "assessment_state",
    "conclusion",
    "confirmed_facts",
    "engineering_judgment",
    "counter_explanation",
    "remaining_uncertainty",
    "locations",
    "recommended_action",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "aet-investigated-finding/v1"
    },
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "finding_type": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "enum": [
        "DETERMINISTIC_FINDING",
        "INVESTIGATED_FINDING",
        "HYPOTHESIS"
      ]
    },
    "authoritative_status": {
      "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE"]
    },
    "blocking": {
      "type": "boolean",
      "default": false
    },
    "assessment_state": {
      "enum": [
        "CONFIRMED",
        "SUPPORTED",
        "SUPPORTED_WITH_LIMITS",
        "CONFLICTED",
        "UNSUPPORTED",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "conclusion": {
      "type": "string",
      "minLength": 1
    },
    "confirmed_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/groundedFact"
      }
    },
    "engineering_judgment": {
      "type": "string"
    },
    "counter_explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "investigation_result", "evidence_refs"],
      "properties": {
        "statement": {
          "type": "string"
        },
        "investigation_result": {
          "enum": [
            "SUPPORTED",
            "WEAKENED",
            "REJECTED",
            "UNRESOLVED",
            "NOT_APPLICABLE"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/referenceList"
        }
      }
    },
    "remaining_uncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "recommended_action": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "$ref": "#/$defs/referenceList"
    },
    "conflicting_evidence_refs": {
      "$ref": "#/$defs/referenceList"
    },
    "search_scope_refs": {
      "$ref": "#/$defs/referenceList"
    },
    "could_change_conclusion": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "origin": {
            "const": "HYPOTHESIS"
          }
        },
        "required": ["origin"]
      },
      "then": {
        "properties": {
          "authoritative_status": {
            "const": "UNKNOWN"
          },
          "assessment_state": {
            "enum": ["UNKNOWN", "SUPPORTED_WITH_LIMITS", "CONFLICTED"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assessment_state": {
            "const": "CONFIRMED"
          }
        },
        "required": ["assessment_state"]
      },
      "then": {
        "properties": {
          "origin": {
            "const": "DETERMINISTIC_FINDING"
          }
        }
      }
    }
  ],
  "$defs": {
    "referenceList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "groundedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "kind", "evidence_refs"],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "tool_fact",
            "test_passed",
            "negative_search",
            "explicit_user_constraint",
            "freshness"
          ]
        },
        "source_type": {
          "enum": [
            "explicit_user",
            "explicit_project",
            "inferred",
            "unknown"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "search_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_refs": {
          "$ref": "#/$defs/referenceList"
        }
      }
    }
  }
}
