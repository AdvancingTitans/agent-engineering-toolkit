{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AdvancingTitans/agent-engineering-toolkit/schemas/demo/v1/demo-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "demo_id",
    "title",
    "fixture_path",
    "command",
    "relevant_paths",
    "expected_before",
    "expected_after",
    "mutations",
    "timeout_seconds"
  ],
  "properties": {
    "schema_version": {"const": "aet-demo-manifest/v1"},
    "demo_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "fixture_path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\\\u0000]+$"},
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "relevant_paths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\\\u0000]+$"}
    },
    "expected_before": {"const": "EXACT_MATCH"},
    "expected_after": {"const": "RELEVANT_FILES_CHANGED"},
    "mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "operation", "expected_old_sha256", "old", "new"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\\\u0000]+$"},
          "operation": {"const": "replace_text"},
          "expected_old_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "old": {"type": "string", "minLength": 1},
          "new": {"type": "string", "minLength": 1}
        }
      }
    },
    "timeout_seconds": {"type": "integer", "minimum": 1}
  }
}
