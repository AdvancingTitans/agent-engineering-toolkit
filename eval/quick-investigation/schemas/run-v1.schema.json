{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advancingtitans.github.io/aet/eval/quick-investigation/schemas/run-v1.schema.json",
  "title": "AET Quick Investigation Benchmark Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "suite_id",
    "scenario_id",
    "group",
    "repetition",
    "runner",
    "model",
    "model_parameters",
    "usage",
    "wall_time_seconds",
    "tool_calls",
    "output",
    "grounding",
    "raw_jsonl"
  ],
  "properties": {
    "schema_version": {"const": "quick-investigation-run/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "suite_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "pattern": "^SCOPE-[0-9]{3}$"},
    "group": {
      "enum": [
        "pure_rules",
        "one_shot_llm",
        "investigated_aet",
        "investigated_grounded"
      ]
    },
    "repetition": {"type": "integer", "minimum": 0},
    "runner": {"enum": ["deterministic", "codex"]},
    "model": {"type": ["string", "null"]},
    "model_parameters": {"type": "object"},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "input_tokens", "output_tokens", "reasoning_tokens", "total_tokens"],
      "properties": {
        "status": {"enum": ["EVIDENCED", "UNKNOWN"]},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "wall_time_seconds": {"type": "number", "minimum": 0},
    "tool_calls": {"type": "integer", "minimum": 0},
    "output": {"$ref": "#/$defs/output"},
    "grounding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "accepted_claims", "rejected_claims"],
      "properties": {
        "status": {"enum": ["PASS", "REJECTED", "NOT_APPLICABLE"]},
        "accepted_claims": {"type": "integer", "minimum": 0},
        "rejected_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "reason"],
            "properties": {
              "claim_id": {"type": "string"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "raw_jsonl": {"type": ["string", "null"]}
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "assessment_state", "evidence_refs"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "assessment_state": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "counter_explanation": {
          "type": "string"
        },
        "counter_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "remaining_uncertainty": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "claims"],
      "properties": {
        "schema_version": {"const": "quick-investigation-output/v1"},
        "status": {"enum": ["COMPLETE", "UNKNOWN"]},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
      }
    }
  }
}
