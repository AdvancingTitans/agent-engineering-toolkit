{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advancingtitans.github.io/agent-engineering-toolkit/schemas/review-graph/v1/code-graph.schema.json",
  "title": "AET Code Graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot", "index", "nodes", "edges", "diagnostics"],
  "properties": {
    "schema_version": {"const": "aet-code-graph/1.0"},
    "snapshot": {"$ref": "#/$defs/snapshot"},
    "index": {"type": "object"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "diagnostics": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "state": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE"]},
    "snapshot": {
      "type": "object",
      "required": ["status", "head_sha", "worktree_digest", "digest"]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "state", "authority", "text", "source_refs", "attributes", "mandatory", "priority"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "state": {"$ref": "#/$defs/state"},
        "authority": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1},
        "attributes": {"type": "object"},
        "mandatory": {"type": "boolean"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "relation", "state", "authority", "source_refs", "attributes", "priority"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "relation": {"type": "string", "minLength": 1},
        "state": {"$ref": "#/$defs/state"},
        "authority": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1},
        "attributes": {"type": "object"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    }
  }
}
