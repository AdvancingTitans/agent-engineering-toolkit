{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advancingtitans.github.io/agent-engineering-toolkit/schemas/evidence-bundle/v1/index.schema.json",
  "title": "Portable Evidence Bundle Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "question", "claim_refs", "evidence_refs", "observation_refs", "reading_order", "excluded", "archive_available", "consumer_guidance"],
  "properties": {
    "extensions": {"type": "object", "additionalProperties": true},
    "schema_version": {"const": "portable-evidence-bundle-index/1.0"},
    "bundle_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "claim_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "observation_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "reading_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "excluded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "reason"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "archive_available": {"type": "boolean"},
    "consumer_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must", "must_not"],
      "properties": {
        "must": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "must_not": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    }
  }
}
